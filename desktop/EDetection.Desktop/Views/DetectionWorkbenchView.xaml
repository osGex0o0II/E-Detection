<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EDetection.Desktop.Views.DetectionWorkbenchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root"
          Background="{ThemeResource AppPageBackgroundBrush}"
          RowSpacing="12"
          SizeChanged="Root_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MetricLayoutStates">
                <VisualState x:Name="WideMetrics">
                    <VisualState.StateTriggers>
                        <StateTrigger x:Name="WideMetricsTrigger" IsActive="True" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MetricRow1.Height" Value="0" />
                        <Setter Target="MetricColumn2.Width" Value="*" />
                        <Setter Target="MetricColumn3.Width" Value="*" />
                        <Setter Target="AnomalyRecordsMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="AnomalyRecordsMetricCard.(Grid.Column)" Value="2" />
                        <Setter Target="AnomalyRecordsMetricCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SkippedMetricCard.(Grid.Row)" Value="0" />
                        <Setter Target="SkippedMetricCard.(Grid.Column)" Value="3" />
                        <Setter Target="SkippedMetricCard.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactMetrics">
                    <VisualState.StateTriggers>
                        <StateTrigger x:Name="CompactMetricsTrigger" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MetricRow1.Height" Value="Auto" />
                        <Setter Target="MetricColumn2.Width" Value="0" />
                        <Setter Target="MetricColumn3.Width" Value="0" />
                        <Setter Target="AnomalyRecordsMetricCard.(Grid.Row)" Value="1" />
                        <Setter Target="AnomalyRecordsMetricCard.(Grid.Column)" Value="0" />
                        <Setter Target="AnomalyRecordsMetricCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SkippedMetricCard.(Grid.Row)" Value="1" />
                        <Setter Target="SkippedMetricCard.(Grid.Column)" Value="1" />
                        <Setter Target="SkippedMetricCard.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="MetricGrid"
              Grid.Row="0"
              AutomationProperties.AutomationId="WorkbenchMetricGrid"
              ColumnSpacing="12"
              RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="MetricRow1" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MetricColumn0" Width="*" />
                <ColumnDefinition x:Name="MetricColumn1" Width="*" />
                <ColumnDefinition x:Name="MetricColumn2" Width="*" />
                <ColumnDefinition x:Name="MetricColumn3" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ProcessedMetricCard"
                    Grid.Column="0"
                    Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="文件"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding WorkbenchProcessedSummary}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border x:Name="AnomalyFilesMetricCard"
                    Grid.Column="1"
                    Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="异常文件"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding WorkbenchAnomalyFiles}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border x:Name="AnomalyRecordsMetricCard"
                    Grid.Column="2"
                    Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="异常记录"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding WorkbenchAnomalyRecords}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border x:Name="SkippedMetricCard"
                    Grid.Column="3"
                    Style="{StaticResource MetricCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="跳过"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding WorkbenchSkippedFiles}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource MetricCardStyle}"
                Visibility="{Binding WorkbenchActivityVisibility}">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WorkbenchActivityTitleText}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Off" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding WorkbenchProgressText}"
                               Visibility="{Binding StatusProgressVisibility}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Off" />
                </Grid>
                <Grid Visibility="{Binding RunTelemetryVisibility}"
                      RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding RunTelemetry.CurrentFileText}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding RunTelemetry.CurrentFileText}" />
                        <ProgressBar Grid.Column="1"
                                     Width="160"
                                     Minimum="0"
                                     Maximum="100"
                                     IsIndeterminate="{Binding WorkbenchProgressIsIndeterminate}"
                                     Value="{Binding WorkbenchProgressPercent}" />
                    </Grid>
                    <Grid x:Name="RunTelemetryStatsGrid"
                          Grid.Row="1"
                          ColumnSpacing="14"
                          RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TelemetryColumn0" Width="1.4*" />
                            <ColumnDefinition x:Name="TelemetryColumn1" Width="*" />
                            <ColumnDefinition x:Name="TelemetryColumn2" Width="*" />
                            <ColumnDefinition x:Name="TelemetryColumn3" Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="TelemetryProgressPanel" Spacing="2">
                            <TextBlock Text="进度"
                                       Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Text="{Binding RunTelemetry.ProgressDetailText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="TelemetrySpeedPanel" Grid.Column="1" Spacing="2">
                            <TextBlock Text="速度"
                                       Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Text="{Binding RunTelemetry.SpeedText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="TelemetryElapsedPanel" Grid.Column="2" Spacing="2">
                            <TextBlock Text="已用"
                                       Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Text="{Binding RunTelemetry.ElapsedText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="TelemetryRemainingPanel" Grid.Column="3" Spacing="2">
                            <TextBlock Text="剩余"
                                       Style="{StaticResource TableHeaderTextStyle}" />
                            <TextBlock Text="{Binding RunTelemetry.RemainingText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <TextBlock Text="{Binding WorkbenchReportPathText}"
                           Visibility="{Binding ReportActionsVisibility}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{Binding WorkbenchReportPathText}" />
                <Border Visibility="{Binding CancelConfirmationVisibility}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;"
                                  FontSize="14"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{Binding CancelConfirmationText}"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Visibility="{Binding CompletionActionsVisibility}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,10,0,0">
                    <Grid x:Name="CompletionActionsLayout" ColumnSpacing="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CompletionTextColumn" Width="*" />
                            <ColumnDefinition x:Name="CompletionButtonColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding CompletionActionTitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CompletionActionBodyText}"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="CompletionButtonPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding CopyCompletionSummaryCommand}"
                                    AutomationProperties.Name="复制检测完成摘要" ToolTipService.ToolTip="复制检测完成摘要">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="复制摘要" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenCurrentReportCommand}"
                                    AutomationProperties.Name="打开最新报告" ToolTipService.ToolTip="打开最新报告">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="打开报告" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenCurrentReportFolderCommand}"
                                    AutomationProperties.Name="打开报告所在目录" ToolTipService.ToolTip="打开报告所在目录">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="所在目录" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenFirstAnomalySourceCommand}"
                                    AutomationProperties.Name="定位首个异常源文件" ToolTipService.ToolTip="定位首个异常源文件">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="定位首个异常" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{Binding ReportActionsVisibility}">
                    <Button Command="{Binding OpenCurrentReportCommand}"
                            AutomationProperties.Name="{Binding WorkbenchReportButtonText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                            <TextBlock Text="{Binding WorkbenchReportButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenCurrentReportFolderCommand}"
                            AutomationProperties.Name="{Binding WorkbenchReportFolderButtonText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock Text="{Binding WorkbenchReportFolderButtonText}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopyCurrentReportPathCommand}"
                            Style="{StaticResource UtilityIconButtonStyle}"
                            AutomationProperties.Name="复制报告路径" ToolTipService.ToolTip="复制报告路径">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                    <Button Command="{Binding ShowCurrentRunCommand}"
                            Visibility="{Binding SnapshotActionsVisibility}"
                            AutomationProperties.Name="返回当前检测状态">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="返回当前状态" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Visibility="{Binding FailureActionsVisibility}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,10,0,0">
                    <Grid x:Name="FailureActionsLayout" ColumnSpacing="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FailureTextColumn" Width="*" />
                            <ColumnDefinition x:Name="FailureButtonColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding FailureActionTitleText}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FailureActionBodyText}"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="FailureButtonPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding RefreshDiagnosticsCommand}"
                                    AutomationProperties.Name="检查状态" ToolTipService.ToolTip="检查状态">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="检查状态" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyDiagnosticsCommand}"
                                    Style="{StaticResource UtilityIconButtonStyle}"
                                    AutomationProperties.Name="复制状态详情" ToolTipService.ToolTip="复制状态详情">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource MetricCardStyle}">
            <Grid x:Name="RiskLayout"
                  ColumnSpacing="18"
                  RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HighRiskColumn" Width="1.4*" />
                    <ColumnDefinition x:Name="IssueRankColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="HighRiskPanel" AutomationProperties.AutomationId="WorkbenchHighRiskPanel" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="高风险设备"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Border Width="1"
                                    Height="14"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="2,0" />
                            <TextBlock Text="{Binding WorkbenchReportDeviceCountText}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ItemsRepeater Grid.Row="1"
                                   ItemsSource="{Binding WorkbenchHighRiskDevices}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding MainIssueTypes}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding MainIssueTypes}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Subtitle}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding Subtitle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>

                <StackPanel x:Name="IssueRankPanel" Grid.Column="1" Spacing="10">
                    <TextBlock Text="异常类型排行"
                               Style="{StaticResource SectionTitleTextStyle}" />
                    <ItemsRepeater ItemsSource="{Binding WorkbenchTopIssueTypes}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Count}"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="{Binding WorkbenchSensorOverviewText}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource MetricCardStyle}">
            <TabView IsAddTabButtonVisible="False"
                     CanDragTabs="False"
                     CanReorderTabs="False">
                <TabViewItem Header="异常明细"
                             IsClosable="False">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="异常明细预览"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Grid.Column="1"
                                       Margin="0,0,12,0"
                                       Text="{Binding WorkbenchDetailPreviewStatusText}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite"
                                       ToolTipService.ToolTip="{Binding WorkbenchDetailPreviewStatusText}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DetailSortStatusText}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.AutomationId="DetailSortStatus"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>

                        <Grid x:Name="DetailFilterGrid"
                              Grid.Row="1"
                              ColumnSpacing="10"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="0" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DetailSearchColumn" Width="*" />
                                <ColumnDefinition x:Name="DetailSeverityColumn" Width="132" />
                                <ColumnDefinition x:Name="DetailIssueColumn" Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DetailSearchBox"
                                     Text="{Binding DetailSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="搜索建筑、文件、异常或建议" AutomationProperties.Name="搜索异常明细" />
                            <ComboBox x:Name="SeverityFilter"
                                      Grid.Column="1"
                                      SelectedIndex="{Binding SelectedSeverityFilterIndex, Mode=TwoWay}"
                                           AutomationProperties.Name="筛选异常等级"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="全部等级" />
                                <ComboBoxItem Content="高" />
                                <ComboBoxItem Content="中" />
                                <ComboBoxItem Content="低" />
                            </ComboBox>
                            <ComboBox x:Name="IssueTypeFilter"
                                      Grid.Column="2"
                                      ItemsSource="{Binding DetailIssueTypeFilters}"
                                      SelectedIndex="{Binding SelectedIssueTypeFilterIndex, Mode=TwoWay}"
                                           AutomationProperties.Name="筛选异常类型"
                                      HorizontalAlignment="Stretch" />
                            <StackPanel x:Name="DetailActionsPanel" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ClearDetailFiltersButton"
                                         Command="{Binding ClearDetailFiltersCommand}"
                                         Style="{StaticResource UtilityIconButtonStyle}"
                                         AutomationProperties.Name="清除筛选" ToolTipService.ToolTip="清除筛选">
                                         <FontIcon Glyph="&#xE894;" FontSize="14" />
                                 </Button>
                                <Button x:Name="OpenSelectedDetailSourceButton"
                                         Command="{Binding OpenSelectedDetailSourceCommand}"
                                         AutomationProperties.Name="定位源文件" ToolTipService.ToolTip="定位源文件">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                     <FontIcon Glyph="&#xE838;" FontSize="14" />
                                            <TextBlock Text="定位源文件" />
                                        </StackPanel>
                                 </Button>
                                <Button x:Name="CopySelectedDetailButton"
                                         Command="{Binding CopySelectedDetailCommand}"
                                         AutomationProperties.Name="复制选中明细" ToolTipService.ToolTip="复制选中明细">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                     <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            <TextBlock Text="复制明细" />
                                        </StackPanel>
                                 </Button>
                                <Button AutomationProperties.Name="更多明细操作" ToolTipService.ToolTip="更多明细操作">
                                    <Button.Flyout>
                                        <MenuFlyout Opening="DetailActionsFlyout_Opening">
                                            <MenuFlyoutItem x:Name="CopyDetailPathMenuItem" Text="复制源文件路径" Click="CopyDetailPathMenuItem_Click" />
                                            <MenuFlyoutItem x:Name="CopyFilteredDetailsMenuItem" Text="复制筛选结果" Click="CopyFilteredDetailsMenuItem_Click" />
                                            <MenuFlyoutItem x:Name="ExplainSelectedDetailMenuItem" Text="智能解读选中异常" Click="ExplainSelectedDetailMenuItem_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                 <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <TextBlock Text="更多" />
                                    </StackPanel>
                                     </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3"
                              RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,0,12,6">
                                <Grid x:Name="DetailHeaderGrid"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="DetailHeaderSeverityColumn" Width="46" />
                                        <ColumnDefinition x:Name="DetailHeaderDeviceColumn" Width="1.2*" />
                                        <ColumnDefinition x:Name="DetailHeaderIssueColumn" Width="1.8*" />
                                        <ColumnDefinition x:Name="DetailHeaderValueColumn" Width="{Binding DetailValueColumnWidth}" />
                                        <ColumnDefinition x:Name="DetailHeaderActionColumn" Width="1.4*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding SortDetailsCommand}"
                                            CommandParameter="severity"
                                            AutomationProperties.Name="按等级排序"
                                            AutomationProperties.HelpText="切换等级列的升序、降序与默认顺序">
                                        <TextBlock Text="{Binding DetailSeverityHeaderText}" Style="{StaticResource TableHeaderTextStyle}" />
                                    </Button>
                                    <Button Grid.Column="1"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding SortDetailsCommand}"
                                            CommandParameter="device"
                                            AutomationProperties.Name="按设备排序"
                                            AutomationProperties.HelpText="切换设备列的升序、降序与默认顺序">
                                        <TextBlock Text="{Binding DetailDeviceHeaderText}" Style="{StaticResource TableHeaderTextStyle}" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding SortDetailsCommand}"
                                            CommandParameter="issue"
                                            AutomationProperties.Name="按异常排序"
                                            AutomationProperties.HelpText="切换异常列的升序、降序与默认顺序">
                                        <TextBlock Text="{Binding DetailIssueHeaderText}" Style="{StaticResource TableHeaderTextStyle}" />
                                    </Button>
                                    <Button x:Name="DetailHeaderValueButton"
                                            Grid.Column="3"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding SortDetailsCommand}"
                                            CommandParameter="value"
                                            Visibility="{Binding DetailValueColumnVisibility}"
                                            AutomationProperties.Name="按异常值排序"
                                            AutomationProperties.HelpText="切换异常值列的升序、降序与默认顺序">
                                        <TextBlock Text="{Binding DetailValueHeaderText}" Style="{StaticResource TableHeaderTextStyle}" />
                                    </Button>
                                    <Button Grid.Column="4"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding SortDetailsCommand}"
                                            CommandParameter="recommendation"
                                            AutomationProperties.Name="按建议排序"
                                            AutomationProperties.HelpText="切换建议列的升序、降序与默认顺序">
                                        <TextBlock Text="{Binding DetailRecommendationHeaderText}" Style="{StaticResource TableHeaderTextStyle}" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Visibility="{Binding LlmDetailExplanationVisibility}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="智能解读"
                                               Style="{StaticResource TableHeaderTextStyle}" />
                                    <TextBlock Text="{Binding LlmDetailExplanationText}"
                                               TextWrapping="WrapWholeWords"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2">
                                <!--
                                    The scrollbar appears on demand, which narrowed the
                                    rows while the header above kept the full width and
                                    every column drifted.  The header's right inset is
                                    synced to the real scrollbar width in code-behind.
                                -->
                                <!--
                                    The workbench page sits inside the shell's
                                    ScrollViewer, so a ListView here could grow
                                    to its full item height, lose virtualization
                                    and swallow the page scroll.  Cap it so it
                                    keeps its own scrollbar.
                                -->
                                <ListView x:Name="DetailTable"
                                          ItemsSource="{Binding WorkbenchFilteredDetailPreview}"
                                          SelectedItem="{Binding SelectedDetail, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                                          MaxHeight="420"
                                          Loaded="DetailTable_Loaded"
                                          SizeChanged="DetailTable_SizeChanged"
                                          AutomationProperties.Name="异常明细表"
                                          AutomationProperties.AutomationId="DetailTable">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="12,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.8*" />
                                                    <ColumnDefinition Width="{Binding DataContext.DetailValueColumnWidth, ElementName=DetailTable}" />
                                                    <ColumnDefinition Width="1.4*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Severity}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Top"
                                                           ToolTipService.ToolTip="{Binding Severity}" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding LocationText}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{Binding LocationText}" />
                                                    <TextBlock Text="{Binding TimeText}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{Binding TimeText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding IssueText}"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="2"
                                                           FontSize="13"
                                                           ToolTipService.ToolTip="{Binding IssueText}" />
                                                <TextBlock x:Name="DetailValueCellText"
                                                           Grid.Column="3"
                                                           Text="{Binding ValueText}"
                                                           Visibility="{Binding DataContext.DetailValueColumnVisibility, ElementName=DetailTable}"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontSize="13"
                                                           ToolTipService.ToolTip="{Binding ValueText}" />
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding RecommendedAction}"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="2"
                                                           FontSize="13"
                                                           ToolTipService.ToolTip="{Binding RecommendedAction}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="DetailEmptyState"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="4"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding DetailTableEmptyStateVisibility}">
                                    <FontIcon Glyph="&#xE9D9;"
                                              FontSize="22"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{Binding DetailTableEmptyStateTitle}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               AutomationProperties.AutomationId="DetailEmptyState" />
                                    <TextBlock Text="{Binding DetailTableEmptyStateHint}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxWidth="320"
                                               TextAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="运行记录"
                             IsClosable="False">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="运行记录"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RuntimeLogs.StatusText}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid Grid.Row="1"
                              ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RuntimeLogs.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="搜索运行记录"
                                     AutomationProperties.Name="搜索运行记录" />
                            <ComboBox Grid.Column="1"
                                      MinWidth="120"
                                      ItemsSource="{Binding RuntimeLogs.LogKindFilters}"
                                      SelectedIndex="{Binding RuntimeLogs.SelectedKindFilterIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="筛选运行记录类型" />
                            <Button Grid.Column="2"
                                    Command="{Binding CopyFilteredLogsCommand}"
                                    AutomationProperties.Name="复制运行记录"
                                    ToolTipService.ToolTip="复制当前筛选结果">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ClearLogFiltersCommand}"
                                    AutomationProperties.Name="清除运行记录筛选"
                                    ToolTipService.ToolTip="清除搜索与类型筛选">
                                <FontIcon Glyph="&#xE894;" FontSize="14" />
                            </Button>
                        </Grid>
                        <ListView Grid.Row="2"
                                  ItemsSource="{Binding RuntimeLogs.FilteredLogItems}"
                                  SelectionMode="None"
                                  ItemContainerStyle="{StaticResource DenseListViewItemStyle}"
                                  AutomationProperties.Name="运行记录列表">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Kind}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Message}"
                                                   TextWrapping="WrapWholeWords" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>
            </TabView>
        </Border>
    </Grid>
</UserControl>
