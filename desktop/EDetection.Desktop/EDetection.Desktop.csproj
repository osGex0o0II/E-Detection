<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EDetection.Desktop</RootNamespace>
    <AssemblyName>EDetection</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <Version>2.0.3</Version>
    <AssemblyVersion>2.0.3.0</AssemblyVersion>
    <FileVersion>2.0.3.0</FileVersion>
    <Product>E-Detection</Product>
    <Description>Windows native workbench for E-Detection electrical anomaly analysis.</Description>
    <Authors>E-Detection OSS</Authors>
    <Company>E-Detection OSS</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EDetection.Desktop.Core\EDetection.Desktop.Core.csproj" />
    <ProjectReference Include="..\EDetection.Infrastructure\EDetection.Infrastructure.csproj" />
    <ProjectReference Include="..\EDetection.NativeCore\EDetection.NativeCore.csproj" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\running.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <!--
      SelfContained only bundles the .NET runtime.  Without this, the Windows
      App SDK stays framework-dependent and the published app needs the Windows
      App Runtime preinstalled - which the installer never provisions, so a
      clean machine cannot start it.  Requires WindowsPackageType=None (set
      above) and makes the WinAppSDK binaries part of the publish output.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <Target Name="CopyWinUIResourcesToPublishDirectory" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <WinUIResourceFile
        Include="$(OutputPath)**\*.xbf;$(OutputPath)**\*.pri"
        Exclude="$(OutputPath)publish\**" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUIResourceFile)"
      DestinationFiles="@(WinUIResourceFile->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
