<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- xunit.v3 includes its own Microsoft.Testing.Platform runner (see global.json),
       so VSTest assets (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio) and the
       VSTest coverlet collector are intentionally not referenced. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EDetection.Desktop.Core\EDetection.Desktop.Core.csproj" />
    <ProjectReference Include="..\EDetection.Domain\EDetection.Domain.csproj" />
    <ProjectReference Include="..\EDetection.Infrastructure\EDetection.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
